<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the parts of the plugin that only work on Windows (icons, picture files) on a real
       Windows machine. Run by .github/workflows/ci.yml, or locally with `dotnet run`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\WindowsShell.cs" Link="WindowsShell.cs" />
    <Compile Include="..\..\Png.cs" Link="Png.cs" />
  </ItemGroup>

</Project>
